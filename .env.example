# ==============================================================================
# ModelBench Environment Configuration Example
# Copy this file to .env and adjust as needed for your local environment.
# Never commit real API keys, secrets, or your .env file to version control.
# ==============================================================================

# Application Metadata
MODELBENCH_APP_NAME="ModelBench"
MODELBENCH_APP_VERSION="0.1.0"
MODELBENCH_APP_ENV="development"
MODELBENCH_DEBUG=false

# Server Configuration
MODELBENCH_API_HOST="0.0.0.0"
MODELBENCH_API_PORT=8000

# Benchmark Simulation Defaults
# Default artificial latency added by the deterministic mock provider (in milliseconds)
MODELBENCH_DEFAULT_MOCK_DELAY_MS=120.0

# Future Provider Placeholders (Optional - Not required for current mock benchmarks)
# MODELBENCH_OPENAI_API_KEY="sk-placeholder-openai-key"
# MODELBENCH_ANTHROPIC_API_KEY="sk-ant-placeholder-anthropic-key"
